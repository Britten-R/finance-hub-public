# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Private Outlook "publish calendar" .ics links, comma-separated (one per calendar).
CALENDAR_ICS_URLS=

# Plaid keys from https://dashboard.plaid.com (Developers -> Keys).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake banks) or production (real accounts, needs Plaid approval)
PLAID_ENV=sandbox

# Claude API key from https://platform.claude.com (used for weekly tips).
ANTHROPIC_API_KEY=

# Login. AUTH_SECRET: any random 32+ characters. DASHBOARD_PASSWORD: what you type to sign in.
AUTH_SECRET=
DASHBOARD_PASSWORD=
# Authenticator-app secret (base32). Create it with: node scripts/setup-2fa.mjs
TOTP_SECRET=

# Encrypts Plaid connections in the online database: 32 random bytes, base64url.
TOKEN_KEY=
# Upstash Redis (added automatically when you connect Upstash in Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Canvas calendar feed (Canvas -> Calendar -> Calendar Feed) for school due dates.
CANVAS_ICS_URL=
# Optional: starting point for gas-cost estimates on trips, e.g. "Springfield, IL".
HOME_LOCATION=
# For scripts/sync-agenda.mjs: a folder with one subfolder per course (e.g. ECON_1010) holding the
# syllabus PDF, and an optional notes folder with "Recruiting Status.md" / "Applications Status.md".
COURSES_DIR=
NOTEBOOK_DIR=

# For scripts/agent-key.mjs: your deployed address, e.g. https://<your-project>.vercel.app
SITE_URL=
